{
  "$schema": "https://ramen-schema.org/gcore/0.1.0/schema.json",
  "$id": "https://example.org/dicts/tei/0.1.0/model.json",

  "id": "tei",
  "version": "0.1.0",
  "kind": "GModel",
  "name": "TEI Dictionary",

  "imports": [],

  "classifiers": [
    { "kind": "GDataType", "id": "string", "name": "String" },

    {
      "kind": "GNode",
      "id": "persName",
      "name": "persName",
      "superTypes": [],
      "attributes": [
        { "name": "ref", "typeId": "string", "bounds": { "lowerBound": 0, "upperBound": 1 } },
        { "name": "key", "typeId": "string", "bounds": { "lowerBound": 0, "upperBound": 1 } }
      ],
      "constraints": [
        {
          "id": "c_persName_ref_or_key",
          "language": "ocl",
          "expression": "self.ref->notEmpty() or self.key->notEmpty()",
          "severity": "error",
          "message": "persName must have ref or key"
        }
      ]
    },

    {
      "kind": "GNode",
      "id": "placeName",
      "name": "placeName",
      "superTypes": [],
      "attributes": [
        { "name": "ref", "typeId": "string", "bounds": { "lowerBound": 1, "upperBound": 1 } }
      ]
    }
  ],

  "relations": [],
  "ext": {}
}
