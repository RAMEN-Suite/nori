{
  "$schema": "https://ramen-schema.org/core/0.1.0/schema.json",
  "$id": "https://example.org/dicts/tei/0.1.0/model.json",

  "kind": "Model",
  "id": "tei",
  "name": "TEI Dictionary",

  "imports": [{ "modelId": "https://ramen-schema.org/ramen/0.1.0/schema.json", "alias": "ramen" }],

  "types": [
    {
      "kind": "Class",
      "id": "persName",
      "name": "persName",
      "properties": [
        { "name": "ref", "typeId": "string", "multiplicity": { "lower": 0, "upper": 1 } },
        { "name": "key", "typeId": "string", "multiplicity": { "lower": 0, "upper": 1 } }
      ]
    },
    {
      "kind": "Class",
      "id": "placeName",
      "name": "placeName",
      "properties": [
        { "name": "ref", "typeId": "string", "multiplicity": { "lower": 1, "upper": 1 } }
      ]
    }
  ],

  "associations": [],
  "generalizations": [],

  "constraints": [
    {
      "kind": "Constraint",
      "id": "c_persName_ref_or_key",
      "language": "ocl",
      "body": "self.ref->notEmpty() or self.key->notEmpty()",
      "targetIds": ["persName"]
    }
  ],

  "ext": {}
}
