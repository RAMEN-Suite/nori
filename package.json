{
  "name": "nori",
  "productName": "Nori",
  "description": "Tool for (multi-level) modelling objects across heterogeneous domains in the Digital Humanities.",
  "author": {
    "name": "Sebastian Enns",
    "email": "mail@sebenns.com",
    "url": "https://www.sebenns.com"
  },
  "license": "Apache-2.0",
  "version": "0.1.0",
  "main": "dist/electron/index.js",
  "private": true,
  "scripts": {
    "start": "npm run start:electron",
    "start:editor": "ng serve editor",
    "start:network": "npm run start:editor -- --host 0.0.0.0",
    "start:electron": "npm run setup:electron && npm run build:electron && concurrently --kill-others --success command-desktop --names editor,desktop \"npm run start:editor\" \"npm run wait:editor && electron-forge start\"",
    "wait:editor": "wait-on http://localhost:4200",
    "build": "npm run build:electron && npm run build:editor",
    "build:editor": "ng build editor",
    "build:electron": "node tools/build-electron.mts",
    "watch": "ng build editor --watch --configuration development",
    "lint": "npm run lint:editor && npm run lint:tools",
    "lint:editor": "ng lint editor",
    "lint:tools": "eslint electron/src tools forge.config.ts",
    "lint:fix": "npm run lint:editor -- --fix && npm run lint:tools -- --fix",
    "format": "prettier --check . --ignore-unknown",
    "format:fix": "prettier --write . --ignore-unknown",
    "typecheck": "tsc -p editor/tsconfig.app.json --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "verify": "npm run lint && npm run format && npm run typecheck && npm run build",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "make:mac": "node tools/make-macos.mts",
    "make:mac:signed": "node --env-file-if-exists=.env.local tools/make-macos.mts --signed",
    "make:win": "node tools/make-windows.mts",
    "setup:electron": "node node_modules/electron/install.js",
    "prepare": "git config core.hooksPath .githooks",
    "ng": "ng"
  },
  "dependencies": {
    "@angular/aria": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@jsverse/transloco": "^8.4.0",
    "@lucide/angular": "^1.31.0",
    "@ramen-suite/core": "file:../ramen-core",
    "@sushi-kit/angular": "^0.2.1",
    "d3": "^7.9.0",
    "dexie": "^4.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "elkjs": "^0.12.0",
    "iwanthue": "^2.0.0",
    "rxjs": "~7.8.2",
    "short-unique-id": "^5.3.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.0.0",
    "angular-eslint": "^22.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "wait-on": "^9.0.5"
  },
  "engines": {
    "node": ">=26.3.0 <27",
    "npm": ">=11.16.0 <12"
  }
}
