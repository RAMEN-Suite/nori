{
  "name": "nori",
  "productName": "Nori",
  "description": "Tool for (multi-level) modelling objects across heterogeneous domains in the Digital Humanities.",
  "author": {
    "name": "Sebastian Enns, TH Mittelhessen",
    "email": "sebastian.enns@mni.thm.de",
    "url": "https://www.sebenns.com"
  },
  "license": "Apache-2.0",
  "version": "0.1.0",
  "main": "dist/electron/index.js",
  "private": true,
  "scripts": {
    "build:editor": "ng build",
    "build:electron": "tsx tools/build-electron.ts",
    "format": "prettier --check . --ignore-unknown",
    "format:fix": "prettier --write . --ignore-unknown",
    "host:editor": "ng serve editor --host 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "make": "npm run build:electron && npm run build:editor && npm run make:forge",
    "make:forge": "electron-forge make --arch x64",
    "ng": "ng",
    "package": "npm run build:electron && npm run build:editor && npm run package:forge",
    "package:forge": "electron-forge package",
    "prepare": "git config core.hooksPath .githooks",
    "publish": "npm run build:electron && npm run build:editor && npm run publish:forge",
    "publish:forge": "electron-forge publish",
    "start:editor": "ng serve editor",
    "start:electron": "npm run build:electron && concurrently \"npm run start:editor\" \"npm run wait:editor && electron-forge start\"",
    "typecheck": "tsc -p editor/tsconfig.app.json --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "wait:editor": "wait-on http://localhost:4200",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/aria": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@jsverse/transloco": "^8.4.0",
    "@lucide/angular": "^1.31.0",
    "@ramen-suite/core": "file:../ramen-core",
    "@sushi-kit/angular": "^0.1.2",
    "animate.css": "^4.1.1",
    "d3": "^7.9.0",
    "dexie": "^4.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "iwanthue": "^2.0.0",
    "json-schema-library": "^11.0.4",
    "photoswipe": "^5.4.4",
    "rxjs": "~7.8.2",
    "short-unique-id": "^5.3.2",
    "tailwindcss": "^4.2.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^26.0.0",
    "angular-eslint": "^22.5.0",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "esbuild": "^0.27.7",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.4",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.2"
  },
  "engines": {
    "node": ">=26.3.0 <27",
    "npm": ">=11.16.0 <12"
  }
}
