{
  "name": "nori",
  "productName": "NORI - A Model Layering Tool",
  "description": "Tool for (multi-level) modelling objects across heterogeneous domains in the Digital Humanities.",
  "author": {
    "name": "Sebastian Enns, TH Mittelhessen",
    "email": "sebastian.enns@mni.thm.de",
    "url": "https://www.sebenns.com"
  },
  "license": "Apache-2.0",
  "version": "2026.0.1",
  "main": "dist/electron/index.js",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build:editor": "ng build",
    "build:electron": "tsc --project electron/tsconfig.json",
    "start:editor": "ng serve editor",
    "start:electron": "concurrently \"npm run build:electron\" \"npm run start:editor\" \"npm run wait:editor && electron-forge start\"",
    "wait:editor": "wait-on http://localhost:4200",
    "watch": "ng build --watch --configuration development",
    "package": "npm run build:electron && npm run build:editor && npm run package:forge",
    "package:forge": "tsx node_modules/@electron-forge/cli/src/electron-forge-package",
    "make": "npm run build:electron && npm run build:editor && npm run make:forge",
    "make:forge": "tsx node_modules/@electron-forge/cli/src/electron-forge-make",
    "publish": "npm run build:electron && npm run build:editor && npm run publish:forge",
    "publish:forge": "tsx node_modules/@electron-forge/cli/src/electron-forge-publish"
  },
  "dependencies": {
    "@angular/common": "^21.2.2",
    "@angular/compiler": "^21.2.2",
    "@angular/core": "^21.2.2",
    "@angular/forms": "^21.2.2",
    "@angular/platform-browser": "^21.2.2",
    "@angular/router": "^21.2.2",
    "@primeuix/themes": "^2.0.3",
    "d3": "^7.9.0",
    "dexie": "^4.3.0",
    "electron-squirrel-startup": "^1.0.1",
    "iwanthue": "^2.0.0",
    "json-schema-library": "^11.0.4",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.2",
    "short-unique-id": "^5.3.2",
    "tailwindcss": "^4.2.1",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.2",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/d3": "^7.4.3",
    "@types/jasmine": "~6.0.0",
    "animate.css": "^4.1.1",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "jasmine-core": "~6.1.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "wait-on": "^9.0.4"
  }
}
